DEEPSEEK_API_KEY=

# 可选：LangSmith 追踪。不需要追踪时改为 false。
# 密钥用电脑里已经配置好的 LANGSMITH_API_KEY，不要写进这个文件。
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=travel-guide
LANGSMITH_API_KEY=

# Tavily 联网搜索。密钥放在环境变量里，不要写进仓库。
TAVILY_API_KEY=

# 小红书 MCP。本机服务地址，例如 http://127.0.0.1:18060/mcp。不配就只搜网页。
XHS_MCP_URL=

# 12306。本机先用 HTTP 模式启动：uvx --from mcp-server-12306 mcp-12306
# 不配就跳过火车票。
RAIL_MCP_URL=

# 飞常准机票票价。https://ai.variflight.com 申请，按次计费。不配就跳过。
VARIFLIGHT_API_KEY=

# 高德 Web 服务 Key。路线地图、开放时间、餐馆和酒店的评分人均。不配就跳过。
AMAP_KEY=

# RollingGo 酒店（国内）。https://github.com/RollingGo-AI/RollingGo-hotel-MCP-CN 申请。不配就用 Pilot。
ROLLINGGO_API_KEY=

# Postgres。例如 postgresql://用户:密码@主机:5432/库名。不配就存在内存里，进程一关就没了。
# 终稿写进 public.travel_guide，这张表要先建好；对话存档和长期偏好的表第一次连上会自动建。
DATABASE_URL=
# 对话存档和长期偏好放在哪个模式，默认 travel，不存在会自动建。
DATABASE_SCHEMA=travel
